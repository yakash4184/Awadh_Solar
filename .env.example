# Copy these names into .env.local. Set your own private values; none are preset.
ADMIN_USERNAME=choose-a-private-admin-id
# Use at least 16 characters for the administrator password.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=awadh-media

# Google Sheets Sync for Enquiries (Apps Script Webhook URL)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
# Optional: use this only when configuring the webhook through environment variables.
GOOGLE_SHEETS_WEBHOOK_TOKEN=replace-with-your-own-random-secret
